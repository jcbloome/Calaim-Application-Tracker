rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['jason@carehomefinders.com'] ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid))
      );
    }

    function isEmailLogsAdmin() {
      return isAdmin();
    }

    // Default deny. Add explicit collection rules below.
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Social Workers collection - admin management only
    match /socialWorkers/{socialWorkerId} {
      // Super admins can manage social worker accounts
      allow read, write: if request.auth != null;
      
      // Social workers can read their own profile
      allow read: if request.auth != null && request.auth.uid == socialWorkerId;
      
      // Allow updating last login timestamp
      allow update: if request.auth != null && 
                    request.auth.uid == socialWorkerId &&
                    request.writeFields.hasOnly(['lastLogin']);
    }
    
    // Synced Social Workers collection - super admin only
    match /syncedSocialWorkers/{syncedWorkerId} {
      // Super admins can manage synced social worker data
      allow read, write: if request.auth != null && 
                         request.auth.token.email in ['jason@carehomefinders.com'];
    }

    // User-owned applications (main tracker source)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      match /applications/{applicationId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();

        // Internal staff tracker state used by admin application detail page.
        match /staffTrackers/{trackerId} {
          allow read, list, write: if isAdmin();
        }
      }

      // Per-admin Caspio mapping drafts/settings synced across devices.
      match /admin_settings/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Shared admin settings used for locked Caspio mapping.
    match /admin-settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Admin-created applications collection
    match /applications/{applicationId} {
      allow read, list, create, update, delete: if isAdmin();
    }

    // Needed for collectionGroup('applications') queries in admin pages
    match /{path=**}/applications/{applicationId} {
      allow read, list: if isAdmin();
    }

    // Standalone uploads queue consumed by admin layout/action counters
    match /standalone_upload_submissions/{submissionId} {
      allow read, list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Staff notifications (action items / interoffice notes)
    match /staff_notifications/{notificationId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Member portal login activity (shown in admin application details)
    match /loginLogs/{logId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if isAdmin();
    }
    
    // SW Claims collection
    match /sw-claims/{claimId} {
      // Social workers can create and read their own claims
      allow create: if request.auth != null && 
                    request.auth.uid != null &&
                    request.resource.data.socialWorkerEmail == request.auth.token.email;
      
      allow read: if request.auth != null && 
                  (resource.data.socialWorkerEmail == request.auth.token.email ||
                   // Super admins can read all claims
                   request.auth.token.email in ['jason@carehomefinders.com']);
      
      // Only super admins can update claim status
      allow update: if request.auth != null && 
                    request.auth.token.email in ['jason@carehomefinders.com'];
      
      // Super admins can delete claims
      allow delete: if request.auth != null && 
                    request.auth.token.email in ['jason@carehomefinders.com'];
    }

    // Desktop Presence (Electron online indicator)
    match /desktop_presence/{uid} {
      allow read, list: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.token.email in ['jason@carehomefinders.com'];
    }

    // Email logs (admin read + update/delete for log cleanup and flags)
    match /emailLogs/{logId} {
      allow read, list: if request.auth != null;
      allow create: if false;
      allow update, delete: if isEmailLogsAdmin();
    }

    // System settings (review notifications, app access, etc.)
    match /system_settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Spreadsheet upload/member status tracking for Kaiser batch intake.
    match /ils_spreadsheet_upload_logs/{docId} {
      allow read, write: if isSignedIn();
    }

    // Consolidated ILS MIF master list for Create Application intake.
    match /ils_mif_master_members/{docId} {
      allow read, write: if isSignedIn();
    }

    match /ils_mif_consolidation_runs/{docId} {
      allow read, write: if isSignedIn();

      // Full member snapshot for each dated consolidation run.
      match /members/{memberId} {
        allow read, write: if isSignedIn();
      }

      match /removed/{memberId} {
        allow read, write: if isSignedIn();
      }
    }

    match /ils_mif_declined_members/{docId} {
      allow read, write: if isSignedIn();
    }

    match /ils_mif_northern_decline_batches/{docId} {
      allow read, write: if isSignedIn();
    }

    match /ils_mif_removed_members/{docId} {
      allow read, write: if isSignedIn();
    }

    match /ils_mif_audit_log/{docId} {
      allow read, write: if isSignedIn();
    }

    match /ils_mif_uploaded_files/{docId} {
      allow read, write: if isSignedIn();

      match /members/{memberId} {
        allow read, write: if isSignedIn();
      }
    }

    // Staff Chat (Firestore source of truth)
    match /chat_conversations/{conversationId} {
      function isAdmin() {
        return request.auth != null && (
          request.auth.token.email in ['jason@carehomefinders.com'] ||
          exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
          exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid))
        );
      }

      function isParticipant() {
        return request.auth != null && request.auth.uid in resource.data.participants;
      }

      function isParticipantCreate() {
        return request.auth != null && request.auth.uid in request.resource.data.participants;
      }

      allow get, list: if isAdmin() || isParticipant();
      allow create: if isAdmin() || isParticipantCreate();
      allow update, delete: if isAdmin() || isParticipant();

      match /messages/{messageId} {
        allow get, list: if isAdmin() || (
          request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chat_conversations/$(conversationId)).data.participants
        );
        allow create: if isAdmin() || (
          request.auth != null &&
          request.resource.data.senderUid == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chat_conversations/$(conversationId)).data.participants
        );
        allow update, delete: if isAdmin();
      }
    }
  }
}