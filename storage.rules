rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // HIPAA hardening: submitters can upload/update/delete their own files,
    // but only staff/admin roles can read/view document contents.
    match /user_uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.superAdmin == true ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/roles_super_admin/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.token.email)) ||
          firestore.exists(/databases/(default)/documents/roles_super_admin/$(request.auth.token.email))
        ))
      );
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.admin == true ||
        request.auth.token.superAdmin == true ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/roles_super_admin/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.token.email)) ||
          firestore.exists(/databases/(default)/documents/roles_super_admin/$(request.auth.token.email))
        ))
      );
    }

    // Temporary uploads used by the Super Admin ERA Parser
    // (kept separate from user_uploads/documents)
    match /era_parser_uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.admin == true ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/roles_super_admin/$(request.auth.uid))
      );
    }
    
    // Allow authenticated users to upload to shared folders (admin only)
    match /shared_uploads/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (
          request.auth.token.admin == true ||
          firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
          firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.uid)) ||
          firestore.exists(/databases/(default)/documents/roles_super_admin/$(request.auth.uid))
        );
    }
    
    // Allow authenticated users to upload documents (admin only)
    match /documents/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (
          request.auth.token.admin == true ||
          firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
          firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.uid)) ||
          firestore.exists(/databases/(default)/documents/roles_super_admin/$(request.auth.uid))
        );
    }
    
    // Allow diagnostic tests (temporary, user-specific)
    match /diagnostic-test/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // SW Portal ISP Tools menu files (admin upload; SW/authenticated open via download URL)
    match /sw-isp-tools/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (
          request.auth.token.admin == true ||
          firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
          firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.uid)) ||
          firestore.exists(/databases/(default)/documents/roles_super_admin/$(request.auth.uid))
        );
    }

    // Medication lists for ALFT — assigned SW may upload; all signed-in users can read.
    // Prefer server upload via /api/alft/med-list-upload (Admin SDK) so SW portal works
    // even if these rules are not yet deployed. Client writes still allowed when deployed.
    match /admin_uploads/alft-med-lists/{memberId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.superAdmin == true ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/roles_super_admin/$(request.auth.uid)) ||
        (
          memberId != 'unassigned' &&
          request.auth.token.email != null &&
          firestore.exists(/databases/(default)/documents/alft_assignments/$(memberId)) &&
          (
            firestore.get(/databases/(default)/documents/alft_assignments/$(memberId)).data.assignedSwEmail
              == request.auth.token.email.lower() ||
            firestore.get(/databases/(default)/documents/alft_assignments/$(memberId)).data.assignedSwUid
              == request.auth.uid
          )
        )
      );
    }

    // ALFT workflow support files (602, facesheet, etc.) — admin upload; SW opens via download URL
    match /admin_uploads/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (
          request.auth.token.admin == true ||
          firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
          firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.uid)) ||
          firestore.exists(/databases/(default)/documents/roles_super_admin/$(request.auth.uid))
        );
    }
    
    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}